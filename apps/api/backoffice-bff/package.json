{
  "name": "@piar/backoffice-bff",
  "version": "0.1.0",
  "description": "Backend for Frontend (BFF) API for backoffice application",
  "private": true,
  "license": "MIT",
  "scripts": {
    "build:prepare": "node ../../../scripts/prepare-workspace.mjs",
    "build": "pnpm run build:prepare && nest build --path tsconfig.build.json",
    "dev:prepare": "pnpm run build:prepare",
    "dev": "pnpm run dev:prepare && nest start --watch --path tsconfig.build.json",
    "start": "pnpm run dev:prepare && nest start --path tsconfig.build.json",
    "start:dev": "pnpm run dev",
    "start:debug": "pnpm run dev:prepare && nest start --debug --watch --path tsconfig.build.json",
    "start:prod": "node dist/main",
    "lint": "eslint \"{src,apps,libs,test}/**/*.ts\"",
    "typecheck": "tsc --noEmit",
    "test": "vitest --run --passWithNoTests",
    "test:coverage": "vitest --run --coverage --passWithNoTests"
  },
  "dependencies": {
    "@nestjs/common": "^11.0.16",
    "@nestjs/config": "^4.0.4",
    "@nestjs/core": "^11.0.16",
    "@nestjs/jwt": "^11.0.0",
    "@nestjs/platform-express": "^11.0.16",
    "@nestjs/swagger": "^11.4.7",
    "@piar/accounts-api": "workspace:*",
    "@piar/health-api": "workspace:*",
    "@piar/infra-backend-repositories": "workspace:*",
    "@piar/domain-models": "workspace:*",
    "@piar/infra-backend-common-error": "workspace:*",
    "@piar/infra-backend-common-security": "workspace:*",
    "@piar/infra-backend-common-typeorm": "workspace:*",
    "@piar/auth-api": "workspace:*",
    "@piar/contact-api": "workspace:*",
    "@piar/dynamic-page-api": "workspace:*",
    "@piar/search-api": "workspace:*",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.16",
    "@nestjs/schematics": "^11.0.9",
    "@nestjs/testing": "^11.0.16",
    "@types/express": "^5.0.0",
    "@types/node": "^24.13.3",
    "@typescript-eslint/eslint-plugin": "^8.53.0",
    "@typescript-eslint/parser": "^8.53.0",
    "@vitest/coverage-v8": "^2.1.9",
    "eslint": "^9.39.2",
    "ts-loader": "^9.5.1",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.9.3",
    "vitest": "^2.1.9"
  },
  "engines": {
    "node": ">=24.20.0 <25"
  }
}
