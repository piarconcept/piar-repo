{
  "name": "@piar/infra-backend-repositories",
  "version": "0.1.0",
  "description": "Repository implementations for backend infrastructure",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./account": {
      "types": "./dist/account/index.d.ts",
      "default": "./dist/account/index.js"
    },
    "./contact-submission": {
      "types": "./dist/contact-submission/index.d.ts",
      "default": "./dist/contact-submission/index.js"
    },
    "./dynamic-page": {
      "types": "./dist/dynamic-page/index.d.ts",
      "default": "./dist/dynamic-page/index.js"
    }
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest --run --passWithNoTests",
    "test:coverage": "vitest --run --coverage --passWithNoTests"
  },
  "dependencies": {
    "@nestjs/typeorm": "^11.0.0",
    "typeorm": "^0.3.24",
    "bcryptjs": "^2.4.3",
    "@piar/domain-models": "workspace:*",
    "@piar/domain-dynamic-form": "workspace:*"
  },
  "devDependencies": {
    "@nestjs/common": "^11.0.16",
    "@nestjs/core": "^11.0.16",
    "@types/node": "^24.13.3",
    "@types/bcryptjs": "^2.4.6",
    "@vitest/coverage-v8": "^2.1.9",
    "typescript": "^5.9.3",
    "vitest": "^2.1.9"
  },
  "peerDependencies": {
    "@nestjs/common": "^11.0.0",
    "@nestjs/core": "^11.0.0"
  }
}
