{
  "name": "@piar/dynamic-page-api",
  "version": "0.1.0",
  "private": true,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "dev": "tsc --watch",
    "test": "vitest --run --passWithNoTests",
    "test:coverage": "vitest --run --coverage --passWithNoTests"
  },
  "dependencies": {
    "@piar/domain-dynamic-form": "workspace:*",
    "@piar/dynamic-page-configuration": "workspace:*",
    "@piar/domain-models": "workspace:*",
    "@piar/infra-backend-common-security": "workspace:*",
    "@piar/dynamic-page-infra-backend": "workspace:*",
    "@nestjs/common": "^11.0.16",
    "@nestjs/core": "^11.0.16"
  },
  "devDependencies": {
    "@nestjs/swagger": "^11.4.7",
    "@nestjs/testing": "^11.0.16",
    "@types/node": "^24.13.3",
    "@vitest/coverage-v8": "^2.1.9",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.31.1",
    "vitest": "^2.1.9"
  }
}
