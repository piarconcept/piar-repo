  "author": "Piar Concept <polribasrovira@gmail.com> (https://piarconcept.com)",
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^24.13.3",
    "@vitest/coverage-v8": "^2.1.8",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.31.1",
    "vitest": "^2.1.8"
  }
}
