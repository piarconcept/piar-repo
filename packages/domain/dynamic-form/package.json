{
  "name": "@piar/domain-dynamic-form",
  "version": "0.1.0",
  "private": true,
  "description": "Generic dynamic form/table port and query types (domain contracts)",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest --run",
    "test:coverage": "vitest --run --coverage"
  },
  "keywords": [
    "dynamic-form",
    "dynamic-table",
